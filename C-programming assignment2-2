#include <stdio.h>

#define MAX 5

struct Student
{
    int roll;
    char name[50];
    float marks[3];
    float total;
    float average;
};

void addStudent(struct Student *s, int *count);
void displayStudents(struct Student s[], int count);
void searchStudent(struct Student s[], int count);
void saveFile(struct Student s[], int count);
void retrieveFile(struct Student s[], int *count);

int main()
{
    struct Student s[MAX];
    int count = 0, choice;

    do
    {
        printf("\n--- Student Record Management ---\n");
        printf("1. Add Student\n");
        printf("2. Display Students\n");
        printf("3. Search Student\n");
        printf("4. Save Records\n");
        printf("5. Retrieve Records\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                addStudent(s, &count);
                break;

            case 2:
                displayStudents(s, count);
                break;

            case 3:
                searchStudent(s, count);
                break;

            case 4:
                saveFile(s, count);
                break;

            case 5:
                retrieveFile(s, &count);
                break;

            case 6:
                printf("Exiting program.\n");
                break;

            default:
                printf("Invalid choice!\n");
        }

    } while(choice != 6);

    return 0;
}

void addStudent(struct Student *s, int *count)
{
    int i;

    if(*count >= MAX)
    {
        printf("Maximum students reached!\n");
        return;
    }

    printf("Enter roll number: ");
    scanf("%d", &s[*count].roll);

    printf("Enter name: ");
    scanf(" %49[^\n]", s[*count].name);

    s[*count].total = 0;

    for(i = 0; i < 3; i++)
    {
        printf("Enter marks of subject %d: ", i + 1);
        scanf("%f", &s[*count].marks[i]);

        s[*count].total += s[*count].marks[i];
    }

    s[*count].average = s[*count].total / 3.0;

    (*count)++;

    printf("Student added successfully!\n");
}

void displayStudents(struct Student s[], int count)
{
    int i;

    if(count == 0)
    {
        printf("No student records available.\n");
        return;
    }

    for(i = 0; i < count; i++)
    {
        printf("\nRoll Number: %d\n", s[i].roll);
        printf("Name: %s\n", s[i].name);
        printf("Total Marks: %.2f\n", s[i].total);
        printf("Average Marks: %.2f\n", s[i].average);
    }
}

void searchStudent(struct Student s[], int count)
{
    int roll, i, found = 0;

    printf("Enter roll number to search: ");
    scanf("%d", &roll);

    for(i = 0; i < count; i++)
    {
        if(s[i].roll == roll)
        {
            printf("\nStudent Found!\n");
            printf("Name: %s\n", s[i].name);
            printf("Total Marks: %.2f\n", s[i].total);
            printf("Average Marks: %.2f\n", s[i].average);
            found = 1;
            break;
        }
    }

    if(found == 0)
    {
        printf("Student not found.\n");
    }
}

void saveFile(struct Student s[], int count)
{
    FILE *fp;

    fp = fopen("students.dat", "wb");

    if(fp == NULL)
    {
        printf("File could not be opened.\n");
        return;
    }

    fwrite(&count, sizeof(int), 1, fp);
    fwrite(s, sizeof(struct Student), count, fp);

    fclose(fp);

    printf("Records saved successfully.\n");
}

void retrieveFile(struct Student s[], int *count)
{
    FILE *fp;

    fp = fopen("students.dat", "rb");

    if(fp == NULL)
    {
        printf("File not found.\n");
        return;
    }

    fread(count, sizeof(int), 1, fp);
    fread(s, sizeof(struct Student), *count, fp);

    fclose(fp);

    printf("Records retrieved successfully.\n");
}


